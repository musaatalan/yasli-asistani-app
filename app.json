{
  "expo": {
    "name": "Güvenli Yaşlı Asistanı",
    "slug": "YasliAsistani",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "yasliasistani",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.musaatalan.yasliasistani",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Acil durumda konumunuzu yakınlarınıza iletmek için gereklidir.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Düşme algılama sırasında arka planda konum paylaşımı için gereklidir.",
        "NSMicrophoneUsageDescription": "Düşme uyarısını sesli iptal etmek ve yüksek ses tespiti için mikrofon erişimi gereklidir.",
        "NSPhotoLibraryUsageDescription": "Hızlı rehbere yakınlarınızın fotoğrafını eklemek için galeri erişimi gerekir.",
        "UIBackgroundModes": [
          "location",
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.musaatalan.yasliasistani",
      "adaptiveIcon": {
        "backgroundColor": "#0B1F33",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "SEND_SMS",
        "CALL_PHONE",
        "RECORD_AUDIO",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B1F33"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Acil durumda konumunuzu yakınlarınıza iletmek için gereklidir.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hızlı rehbere yakınlarınızın fotoğrafını eklemek için galeri erişimi gerekir."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "expo-audio",
      "expo-asset",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Düşme uyarısını sesli iptal etmek için mikrofon erişimi gerekir.",
          "speechRecognitionPermission": "Düşme uyarısında 'İPTAL' / 'İYİYİM' komutlarını anlamak için konuşma tanıma gerekir.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cd059a43-1fc4-46e0-bf3e-bfa899fd0200"
      }
    },
    "owner": "musaatalan"
  }
}
